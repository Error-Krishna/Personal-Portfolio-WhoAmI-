# ==============================================================================
# Environment Configuration Template (.env.example)
# Krishna Goyal Portfolio Monorepo
# ==============================================================================
# Copy this file to .env for local development.
# NEVER commit real credentials or .env to version control.
# For Vercel: configure these variables in Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# NOTE: Variables prefixed with VITE_ are bundled into client-side JavaScript.
# NEVER place private credentials, database strings, or secret API keys in VITE_ variables!
# ------------------------------------------------------------------------------
# In a unified Vercel deployment (Option A), leave empty to use relative '/api/v1' on same domain.
# In a decoupled deployment (Option C), set to your production API URL (e.g., https://api.yourdomain.com/api/v1).
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Express / Node.js)
# Used only by the server runtime. Kept private and never exposed to the browser.
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
API_PREFIX=/api/v1

# Allowed origins for CORS. Accepts single origin or comma-separated list.
# For production: set to your production domain(s) (e.g., https://krishnagoyal.com,https://krishna-portfolio.vercel.app)
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB Atlas connection string in production)
# If omitted or unavailable, the backend gracefully runs in non-persisted mode.
MONGODB_URI=mongodb://localhost:27017/krishna_portfolio

# Rate Limiting (express-rate-limit)
# Window duration in milliseconds (default: 900,000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum inquiries permitted per IP within the window
RATE_LIMIT_MAX_REQUESTS=100

# Logging level: 'error' | 'warn' | 'info' | 'http' | 'debug'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# EMAIL DISPATCH CONFIGURATION (Resend or SMTP)
# Used by the backend to dispatch contact form inquiries to your inbox.
# ------------------------------------------------------------------------------
# Option 1: Resend (Recommended for Vercel / serverless)
# Sign up at https://resend.com, generate an API key, and set it below.
RESEND_API_KEY=
# Destination inbox where project inquiries will be sent (default: iamkrishnagoyal@gmail.com)
CONTACT_EMAIL_TO=iamkrishnagoyal@gmail.com
# Sender address. For testing use 'onboarding@resend.dev'; for production use your verified domain
CONTACT_EMAIL_FROM=Krishna Goyal Portfolio <onboarding@resend.dev>

# Option 2: SMTP Gateway (Nodemailer) - Alternative to Resend
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
