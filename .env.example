# Local development only. Replace placeholder values in your ignored .env.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-development-key
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_LOG_LEVEL=INFO

REDIS_URL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7
# Admin Mode signs in as this Django user (create it with `manage.py createsuperuser`).
ADMIN_MODE_USERNAME=Krishna
# Optional absolute path to the private knowledge file; empty = content/krish_private.md
KRISH_PRIVATE_KNOWLEDGE_PATH=

DJANGO_SQLITE_NAME=db.sqlite3
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=Asia/Kolkata

BOOKING_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@localhost
CONTACT_EMAIL=

# Production values belong in the hosting provider's environment settings.
